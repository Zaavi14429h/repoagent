REPOAGENT_ENVIRONMENT=development
REPOAGENT_DATABASE_PATH=.repoagent/repoagent.db
REPOAGENT_WORKSPACE_ROOT=.repoagent/workspaces
REPOAGENT_MAX_CORRECTIONS=3
REPOAGENT_AGENT_BACKEND=crewai
REPOAGENT_MODEL=openai/gpt-4.1-mini
REPOAGENT_MODEL_API_KEY=
REPOAGENT_MODEL_BASE_URL=
REPOAGENT_MODEL_INPUT_COST_PER_MILLION=0
REPOAGENT_MODEL_OUTPUT_COST_PER_MILLION=0
REPOAGENT_ADK_MODEL=gemini-2.5-flash
REPOAGENT_ADK_A2A_URL=http://localhost:8100
REPOAGENT_SANDBOX_MODE=docker
REPOAGENT_PYTHON_RUNNER_IMAGE=repoagent-runner-python:latest
REPOAGENT_NODE_RUNNER_IMAGE=repoagent-runner-node:latest
REPOAGENT_GITHUB_TOKEN=
REPOAGENT_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

